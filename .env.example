# SMMOMO environment template.
# Copy to .env and fill in values. Never commit real secrets.

# --- Frontend (apps/web) ---
# URL the web app uses to reach the Fastify API (flip USE_MOCK=false in
# apps/web/lib/api/client.ts to switch off mocks).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase (application database foundation) ---
# The publishable key is designed to be exposed to browsers (safe in NEXT_PUBLIC_*).
# NEVER put a service_role / sb_secret_ key in this file or anywhere in apps/web —
# if a server-only secret is needed later it belongs to the backend, not this repo.
NEXT_PUBLIC_SUPABASE_URL=https://etwuqthopqrzffdgvhqs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ptMvNEqjdAJoPys6NbpleA_Yu0swj50

# --- Backend (apps/api) ---
# Fastify listens on PORT (default 4000) and allows CORS_ORIGIN in the browser
# (default http://localhost:3000). Defaults work without setting these.
# PORT=4000
# CORS_ORIGIN=http://localhost:3000
# WEB_ORIGIN=http://localhost:3000
# API_ORIGIN=http://localhost:4000
# DATABASE_URL=postgresql://user:password@localhost:5432/smmomo
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET=
# ENCRYPTION_KEY=

# --- Meta / Instagram (Task 015 OAuth — API env only) ---
# Create an Instagram API with Instagram Login app at developers.facebook.com.
# App secret belongs on apps/api only — never apps/web, never commit real values.
# META_REDIRECT_URI must match a Valid OAuth Redirect URI on the Meta app.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/social-accounts/instagram/callback
# META_WEBHOOK_VERIFY_TOKEN=   # reserved for Task 016 webhooks
