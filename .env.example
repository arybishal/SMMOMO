# SMMOMO environment template.
# Copy to .env and fill in values. Never commit real secrets.
#
# Classification (Task 021):
#   client-safe         — safe in browser / NEXT_PUBLIC_*
#   server-only         — apps/api process env; not a "password" but not public
#   secret              — must never leave the server / never commit
#   optional            — defaults work for local dev
#   development-only    — local convenience
#   production-required — must be set correctly before real traffic

# --- Frontend (apps/web) ---
# client-safe + production-required (point at real API origin in prod)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase (application database foundation) ---
# client-safe: publishable key is browser-safe by design.
# NEVER put a service_role / sb_secret_ key here or in apps/web.
NEXT_PUBLIC_SUPABASE_URL=https://etwuqthopqrzffdgvhqs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ptMvNEqjdAJoPys6NbpleA_Yu0swj50

# --- Backend (apps/api) ---
# server-only / optional (defaults work locally).
# PORT=4000
# CORS_ORIGIN=http://localhost:3000          # production-required: real web origin
# WEB_ORIGIN=http://localhost:3000           # production-required: real web origin
# API_ORIGIN=http://localhost:4000           # production-required: real API origin
# DATABASE_URL=postgresql://user:password@localhost:5432/smmomo   # reserved
# REDIS_URL=redis://localhost:6379           # reserved — not used (single instance)
# SESSION_SECRET=                            # reserved

# --- Platform admin / encrypted secrets (Task 018A + 021 — API env only) ---
# server-only: comma-separated emails for /admin/integrations/*.
PLATFORM_ADMIN_EMAILS=
# secret + production-required: 32-byte AES-256-GCM key (64 hex or base64).
# Encrypts platform_settings secrets AND social_accounts.access_token (v1 envelope).
PLATFORM_ENCRYPTION_KEY=

# --- Meta / Instagram (Task 015 OAuth — API env only) ---
# server-only; META_APP_SECRET is a secret. production-required for real OAuth.
# META_REDIRECT_URI must match a Valid OAuth Redirect URI on the Meta app.
META_APP_ID=
META_APP_SECRET=                            # secret
META_REDIRECT_URI=http://localhost:4000/social-accounts/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=                  # secret (webhook handshake)

# --- Service role (webhook/engine/delivery/token writes — API env only) ---
# secret + production-required for webhooks/delivery/usage. Never apps/web.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional local validation knobs ---
# DELIVERY_POLL_MS=5000
# DELIVERY_BATCH=10
# META_GRAPH_BASE=https://graph.instagram.com
