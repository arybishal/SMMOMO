# SMMOMO environment template.
# Copy to .env and fill in values. Never commit real secrets.

# --- Frontend (apps/web) ---
# URL the web app uses to reach the Fastify API (backend not implemented yet).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Backend (apps/api) — reserved, not implemented yet ---
